sconception":"把同一列兩端的平均當成中間格。","id":"c2"},{"text":"23","misconception":"算出中心格後誤當成左中格。","id":"c3"},{"text":"21","id":"c4"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q075-V1","typeId":"數線絕對距離","difficulty":"難","sourceRefs":["S14:p1"],"variantOf":"Q075","variantIndex":1,"prompt":"五個等距點 P、Q、R、S、T 在數線上由左至右，每段長 6。原點在 PT 之間，且 |P|+|Q|＝|T|。原點距離 P 多少單位？","answer":"10","explanation":"若原點在 PQ 內，|P|+|Q|＝6 而 |T| 至少 18，不可能；因此設距 P 為 x，得 x+(x−6)＝24−x，解得 10。","answerFormat":"single-choice","verification":{"equation":"x+(x-6)=24-x","root":"10","domain":"rational"},"format":"single-choice","correctOptionId":"c1","options":[{"text":"10","id":"c1"},{"text":"6","misconception":"直接把原點當成 Q。","id":"c2"},{"text":"12","misconception":"直接假定原點在 PT 正中間。","id":"c3"},{"text":"15","misconception":"列式後漏掉右側距離也含 −x。","id":"c4"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q075-V2","typeId":"數線絕對距離","difficulty":"難","sourceRefs":["S14:p1"],"variantOf":"Q075","variantIndex":2,"prompt":"五個等距點 P、Q、R、S、T 在數線上由左至右，每段長 9。原點在 PT 之間，且 |P|+|Q|＝|T|。原點距離 P 多少單位？","answer":"15","explanation":"若原點在 PQ 內，|P|+|Q|＝9 而 |T| 至少 27，不可能；因此設距 P 為 x，得 x+(x−9)＝36−x，解得 15。","answerFormat":"single-choice","verification":{"equation":"x+(x-9)=36-x","root":"15","domain":"rational"},"format":"single-choice","correctOptionId":"c2","options":[{"text":"9","misconception":"直接把原點當成 Q。","id":"c1"},{"text":"15","id":"c2"},{"text":"18","misconception":"直接假定原點在 PT 正中間。","id":"c3"},{"text":"45/2","misconception":"列式後漏掉右側距離也含 −x。","id":"c4"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q075-V3","typeId":"數線絕對距離","difficulty":"難","sourceRefs":["S14:p1"],"variantOf":"Q075","variantIndex":3,"prompt":"五個等距點 P、Q、R、S、T 在數線上由左至右，每段長 12。原點在 PT 之間，且 |P|+|Q|＝|T|。原點距離 P 多少單位？","answer":"20","explanation":"若原點在 PQ 內，|P|+|Q|＝12 而 |T| 至少 36，不可能；因此設距 P 為 x，得 x+(x−12)＝48−x，解得 20。","answerFormat":"single-choice","verification":{"equation":"x+(x-12)=48-x","root":"20","domain":"rational"},"format":"single-choice","correctOptionId":"c3","options":[{"text":"12","misconception":"直接把原點當成 Q。","id":"c1"},{"text":"24","misconception":"直接假定原點在 PT 正中間。","id":"c2"},{"text":"20","id":"c3"},{"text":"30","misconception":"列式後漏掉右側距離也含 −x。","id":"c4"}],"bankId":"linear-equations","category":"解一元一次方程式"}]}