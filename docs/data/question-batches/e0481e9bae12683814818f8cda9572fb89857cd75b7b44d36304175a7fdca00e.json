{"questions":[{"id":"Q023","typeId":"分數括號混合","difficulty":"難","sourceRefs":["S03:p1","S05:p4","S07:p2","S17:p1"],"prompt":"求使等式 (2*x-1)/3+(x-2)/2=1 成立的 x。","answer":"2","explanation":"合併同類項並移項，得 x＝2；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"(2*x-1)/3+(x-2)/2=1","root":"2","domain":"rational"},"format":"single-choice","correctOptionId":"c3","options":[{"id":"c1","text":"10/7","misconception":"去分母或移項時錯改常數−1的符號。"},{"id":"c2","text":"2/7","misconception":"錯把第二個分子中的−2改成+2。"},{"id":"c3","text":"2"},{"id":"c4","text":"9/7","misconception":"左側已乘6卻漏把右側1乘6。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q024","typeId":"分數括號混合","difficulty":"難","sourceRefs":["S03:p1","S05:p4","S07:p2","S17:p1"],"prompt":"求使等式 2*(x+1)/3-(x-2)/4=(x+1)/6+2 成立的 x。","answer":"4","explanation":"合併同類項並移項，得 x＝4；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"2*(x+1)/3-(x-2)/4=(x+1)/6+2","root":"4","domain":"rational"},"format":"single-choice","correctOptionId":"c4","options":[{"id":"c1","text":"-12","misconception":"移項時把原本右側+2錯改成−2。"},{"id":"c2","text":"8","misconception":"處理減去分式時，將分子內−2錯改成+2。"},{"id":"c3","text":"8/3","misconception":"把兩個分式相減誤當成相加。"},{"id":"c4","text":"4"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q028","typeId":"小數分母混合","difficulty":"難","sourceRefs":["S05:p2"],"prompt":"求使等式 0.5=0.6/0.3+(0.2*x-0.4)/0.4 成立的 x。","answer":"-1","explanation":"合併同類項並移項，得 x＝-1；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"0.5=0.6/0.3+(0.2*x-0.4)/0.4","root":"-1","domain":"rational"},"format":"single-choice","correctOptionId":"c4","options":[{"id":"c1","text":"-5/2","misconception":"分母0.4只除到常數，沒有除到分子中的未知數項。"},{"id":"c2","text":"2","misconception":"第一個除法將被除數與除數顛倒。"},{"id":"c3","text":"-5","misconception":"分子中的減0.4誤看成加0.4。"},{"id":"c4","text":"-1"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q029","typeId":"小數分母混合","difficulty":"難","sourceRefs":["S05:p2"],"prompt":"求使等式 (0.2*x-0.4)/0.2-1=(-0.4*x+1.2)/0.4 成立的 x。","answer":"3","explanation":"合併同類項並移項，得 x＝3；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"(0.2*x-0.4)/0.2-1=(-0.4*x+1.2)/0.4","root":"3","domain":"rational"},"format":"single-choice","correctOptionId":"c1","options":[{"id":"c1","text":"3"},{"id":"c2","text":"2","misconception":"將左側−1移項時處理符號兩次，等同誤改成+1。"},{"id":"c3","text":"1","misconception":"左側分子−0.4的負號誤改為正。"},{"id":"c4","text":"0","misconception":"右側分子+1.2的正號誤改為負。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q030","typeId":"巢狀逆推","difficulty":"難","sourceRefs":["S04:p2","S05:p2","S08:p1"],"prompt":"求使等式 (1/2)*((1/2)*((1/2)*(2*x-2)+3)-1)=1 成立的 x。","answer":"4","explanation":"合併同類項並移項，得 x＝4；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"(1/2)*((1/2)*((1/2)*(2*x-2)+3)-1)=1","root":"4","domain":"rational"},"format":"single-choice","correctOptionId":"c2","options":[{"id":"c1","text":"0","misconception":"逆推最外層減1時方向錯誤，等同把−1當+1。"},{"id":"c2","text":"4"},{"id":"c3","text":"7/4","misconception":"誤把乘1/2當乘2，倒數運算方向混淆。"},{"id":"c4","text":"10","misconception":"逆推加3時移項符號錯誤，等同把+3當−3。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q031","typeId":"巢狀逆推","difficulty":"難","sourceRefs":["S04:p2","S05:p2","S08:p1"],"prompt":"求使等式 (2/3)*((3/4)*((4/5)*(x-1)-2)-1)=1/3 成立的 x。","answer":"6","explanation":"合併同類項並移項，得 x＝6；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"(2/3)*((3/4)*((4/5)*(x-1)-2)-1)=1/3","root":"6","domain":"rational"},"format":"single-choice","correctOptionId":"c3","options":[{"id":"c1","text":"8/3","misconception":"逆推外層減1時方向錯誤，等同將−1誤當+1。"},{"id":"c2","text":"21/5","misconception":"把乘4/5誤當乘5/4，未正確使用反運算。"},{"id":"c3","text":"6"},{"id":"c4","text":"1","misconception":"逆推減2時符號處理錯誤，等同將−2誤當+2。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q032","typeId":"交錯分數和","difficulty":"難","sourceRefs":["S05:p4","S06:p2"],"prompt":"求使等式 x=2-x/3+x/9-x/27 成立的 x。","answer":"27/17","explanation":"合併同類項並移項，得 x＝27/17；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"x=2-x/3+x/9-x/27","root":"27/17","domain":"rational"},"format":"single-choice","correctOptionId":"c4","options":[{"id":"c1","text":"27/20","misconception":"合併分數項時把原有+x/9誤當成負項。"},{"id":"c2","text":"54/7","misconception":"移項合併時漏掉左側原有的x。"},{"id":"c3","text":"27/16","misconception":"將最後−x/27移項時符號處理兩次。"},{"id":"c4","text":"27/17"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q033","typeId":"交錯分數和","difficulty":"難","sourceRefs":["S05:p4","S06:p2"],"prompt":"求使等式 3-x/4-x/8-x/12=x 成立的 x。","answer":"72/35","explanation":"合併同類項並移項，得 x＝72/35；代入原式左右相等。","answerFormat":"single-choice","verification":{"equation":"3-x/4-x/8-x/12=x","root":"72/35","domain":"rational"},"format":"single-choice","correctOptionId":"c1","options":[{"id":"c1","text":"72/35"},{"id":"c2","text":"72/31","misconception":"合併分數項時錯把最後−x/12當成+x/12。"},{"id":"c3","text":"72/11","misconception":"移項時漏掉右側原本的x。"},{"id":"c4","text":"72/13","misconception":"錯把三個負分數項都改成正項。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q037","typeId":"整數解限制","difficulty":"難","sourceRefs":["S04:p2","S12:p3","S18:p1"],"prompt":"限定 x 為整數。求使等式 x-8=x/3+5 成立的 x。 若沒有整數解，選擇「無解」。","answer":"無解","explanation":"方程式在有理數範圍的解為 39/2，不是整數，因此整數範圍無解。","answerFormat":"single-choice","verification":{"equation":"x-8=x/3+5","root":"39/2","domain":"integer-impossible"},"format":"single-choice","correctOptionId":"c1","options":[{"id":"c1","text":"無解"},{"id":"c2","text":"13","misconception":"移項時漏掉右側x/3，誤把x直接當13。"},{"id":"c3","text":"19","misconception":"將19.5直接捨去小數，卻沒有代回等式驗證。"},{"id":"c4","text":"39/2","misconception":"只求有理數解，忘記題目限定x必須是整數。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q038","typeId":"整數解限制","difficulty":"難","sourceRefs":["S04:p2","S12:p3","S18:p1"],"prompt":"限定 x 為整數。求使等式 4*x+(4*x+1)+(4*x+2)+(4*x+3)=122 成立的 x。 若沒有整數解，選擇「無解」。","answer":"無解","explanation":"方程式在有理數範圍的解為 29/4，不是整數，因此整數範圍無解。","answerFormat":"single-choice","verification":{"equation":"4*x+(4*x+1)+(4*x+2)+(4*x+3)=122","root":"29/4","domain":"integer-impossible"},"format":"single-choice","correctOptionId":"c2","options":[{"id":"c1","text":"29/4","misconception":"忽略x限整數，直接把方程式的有理數解作答。"},{"id":"c2","text":"無解"},{"id":"c3","text":"7","misconception":"把7.25截成整數7，忽略等式必須精確成立。"},{"id":"c4","text":"29","misconception":"算出4x＝29後，把4x的值誤當成x。"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q056","typeId":"參數代入","difficulty":"難","sourceRefs":["S05:p4","S08:p1"],"prompt":"x＝4 是 (2x−k−3)/5−(1+3kx)/4＝−k 的解，求 k。","answer":"15/44","explanation":"(5−k)/5−(1+12k)/4＝−k；乘20後15＝44k。","answerFormat":"single-choice","verification":{"equation":null,"root":null,"domain":"rational"},"format":"single-choice","correctOptionId":"c4","options":[{"id":"c1","text":"5/21","misconception":"乘公分母20時漏把右側−k乘20。"},{"id":"c2","text":"5","misconception":"把3kx誤讀成3k+x，代入4後未算成12k。"},{"id":"c3","text":"-15/76","misconception":"減去括號時，錯把12k的符號改變兩次。"},{"id":"c4","text":"15/44"}],"bankId":"linear-equations","category":"解一元一次方程式"},{"id":"Q058","typeId":"同解求參數","difficulty":"難","sourceRefs":["S05:p3"],"prompt":"3(x+2)＝k−x 與 2(x−3)＝k−3x 同解，求 k。","answer":"54","explanation":"兩式分別k＝4x+6、k＝5x−6，故x＝12、k＝54。","answerFormat":"single-choice","verification":{"equation":null,"root":null,"domain":"rational"},"format":"single-choice","correctOptionId":"c2","options":[{"id":"c1","text":"66","misconception":"求得x＝12後，用k＝5x+6，未保留−6。"},{"id":"c2","text":"54"},{"id":"c3","text":"12","misconception":"只求出兩方程式的共同x值，忘記題目要求k。"},{"id":"c4","text":"42","misconception":"求得x＝12後，用k＝4x−6，錯把常數符號變負。"}],"bankId":"linear-equations","category":"解一元一次方程式"}]}